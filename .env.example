# Required: deepseek or bailian. No automatic fallback is performed.
AGENT_HARNESS_MODEL_PROVIDER=deepseek

# DeepSeek provider
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=

# Bailian provider
DASHSCOPE_API_KEY=
DASHSCOPE_API_KEY_FILE=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-plus

# Model transport
MODEL_PROVIDER_TIMEOUT_SECONDS=90
MODEL_PROVIDER_STREAM_TIMEOUT_SECONDS=120

# Required runtime secrets. Generate independent values for each field.
HARNESS_DB_USER=agent
HARNESS_DB_NAME=agent_harness
HARNESS_DB_PASSWORD=
CONTROL_RUNTIME_SHARED_SECRET=
TOOL_GATEWAY_JWT_SECRET=
TOOL_GATEWAY_JWT_ISSUER=ess-platform

# Optional Harness Control frontend
JWT_SECRET=
CONTROL_PANEL_USERNAME=admin
# Demo only. Change this before exposing Harness Control to any network.
CONTROL_PANEL_PASSWORD=admin123
HARNESS_CONTROL_BIND_HOST=127.0.0.1
HARNESS_CONTROL_PORT=3000

# Runtime
AGENT_HARNESS_PROFILE=prod
AGENT_HARNESS_BIND_HOST=127.0.0.1
AGENT_HARNESS_OBSERVABILITY=local
AGENT_HARNESS_RAG_ENABLED=false
AGENT_HARNESS_RAG_RERANKER_ENABLED=false
AGENT_HARNESS_CONTEXT_CACHE_TTL=15
AGENT_HARNESS_TELEMETRY_TTL_SECONDS=30
AGENT_HARNESS_TELEMETRY_SOH_TTL_SECONDS=604800
AGENT_HARNESS_RAG_ROOT=/app/rag_dataset_20docs
RAG_CORPUS_ID=wind-sun-storage-authoritative

# Optional station integration
STATION_API_BASE_URL=
STATION_API_TOKEN=
STATION_API_TIMEOUT_SECONDS=5

# Optional RAG. Model files are not included; download them to ./models/ when local deployment is needed.
RAG_EMBEDDING_PROVIDER=bailian
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_RERANKER_PROVIDER=tei
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_BASE_URL=http://harness-reranker:80
RAG_RERANKER_CANDIDATE_K=20
# Optional local reranker deployment (enable with --profile rag-local)
RAG_RERANKER_PORT=8089
RAG_RERANKER_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:120-1.9
RAG_RERANKER_DTYPE=float16
RAG_RERANKER_MAX_BATCH_SIZE=32
RAG_MODELSCOPE_MODEL_ID=AI-ModelScope/bge-reranker-v2-m3
RAG_MODELSCOPE_MODEL_REVISION=master
RAG_MODELSCOPE_DOWNLOAD_WORKERS=4
